  "findings": [
    {
      "id": "age_bias",
      "dimension": "age_range",
      "model": "logistic_regression",
      "severity": "high",
      "title": "The champion flags young applicants far more often than older ones",
      "summary": "Applicants aged 18-24 are predicted as defaults 85% of the time although 21% actually default (about 4.1 times the real rate). At ages 55-69 only 6% are flagged (5% actually default). Recall of class 1 goes from 93% for the youngest to 18% for the oldest: young defaulters are caught almost always at the price of many false alarms, while older defaulters are mostly missed. Age is the most important input (25% of the importance), and part of the gap mirrors a real difference in default rates. ROC AUC is similar across ages (0.65 to 0.67), so the ranking quality is comparable and the gap mostly comes from applying one 0.5 threshold with balanced class weights to groups with different base rates.",
      "evidence": {
        "predicted_default_rate": {
          "18-24": 0.8522,
          "25-34": 0.6867,
          "35-44": 0.4504,
          "45-54": 0.2248,
          "55-69": 0.0571
        },
        "default_rate": {
          "18-24": 0.2104,
          "25-34": 0.1698,
          "35-44": 0.1208,
          "45-54": 0.0852,
          "55-69": 0.0535
        },
        "recall": {
          "18-24": 0.9263,
          "25-34": 0.8311,
          "35-44": 0.6555,
          "45-54": 0.4161,
          "55-69": 0.1811
        }
      },
      "recommendation": "Treat age as a sensitive attribute: review the threshold per group, test the model without Age, and keep a human review for rejected young applicants before using it in real decisions."
    },
    {
      "id": "employment_type_gap",
      "dimension": "employment_type",
      "model": "logistic_regression",
      "severity": "moderate",
      "title": "Flag rates differ by employment type, in line with the real default rates",
      "summary": "Unemployed applicants are flagged 49% of the time (13.6% actually default) against 29% for Full-time (9.5% actually default). ROC AUC stays between 0.71 and 0.72.",
      "evidence": {
