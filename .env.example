# Example configuration. Copy it to .env (ignored by git) or set the same variables in the environment
# of the host (in Render: the Environment tab of the service). Every value below is an EXAMPLE:
# never put a real password or key in this file or in the repository.
# The application does not read .env by itself: export the variables, or load the file with your shell.

# development, testing or production
FLASK_CONFIG=development
# Required in production. Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-value
# Empty = local SQLite file in instance/. In production: the PostgreSQL URL given by the host.
DATABASE_URL=
# true = real login; false = everybody runs as the demo account (development only)
AUTH_ENABLED=true
# Password of the public demo account (at least 8 characters). Required in production.
DEMO_PASSWORD=change-me-demo-password
# Empty database for the test suite (the tests create and drop tables). Empty = in-memory SQLite.
TEST_DATABASE_URL=

# Accounts of the Analyst and of the Administrator, created or updated at every start by
# `flask --app run bootstrap-accounts` (the free plan of Render has no shell).
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=change-me-admin-password
BOOTSTRAP_ANALYST_EMAIL=analyst@example.com
BOOTSTRAP_ANALYST_PASSWORD=change-me-analyst-password
# Password read by `flask --app run create-user` (or the variable named with --password-env).
NEW_USER_PASSWORD=change-me-new-user-password

# Logging and the local copy of the prediction log (empty path = off).
LOG_LEVEL=INFO
LOG_FILE=
PREDICTION_LOG_PATH=logs/predictions.jsonl
PREDICTION_LOG_RETENTION_DAYS=90
# Optional paths of the placeholder model.
CREDIT_MODEL_PATH=
CREDIT_SCALER_PATH=
